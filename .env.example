# Formspree endpoint for the contact/reservation form.
# Sign up at https://formspree.io, create a form, and paste its endpoint here.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Optional: hostname of a dev tunnel (e.g. ngrok) to allow through Vite's dev server.
# Leave unset for normal local development.
VITE_DEV_TUNNEL_HOST=
